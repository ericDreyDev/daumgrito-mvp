    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"maria@example.com\",\n  \"phone\": \"11999999999\",\n  \"password\": \"123456\",\n  \"city\": \"São Paulo\",\n  \"neighborhood\": \"Centro\",\n  \"userType\": \"client\"\n}"
            },
            "description": "Cria um usuário cliente ou prestador.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status code is 201', function () {",
                    "  pm.expect(pm.response.code).to.equal(201);",
                    "});",
                    "var json = pm.response.json();",
                    "if (json.token) {",
                    "  pm.collectionVariables.set('authToken', json.token);",
                    "}",
                    "if (json.user && json.user.id) {",
                    "  pm.collectionVariables.set('userId', json.user.id);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          }
        },
        {
          "name": "POST Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "description": "Autentica um usuário e salva o token na variável authToken.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status code is 200', function () {",
                    "  pm.expect(pm.response.code).to.equal(200);",
                    "});",
                    "var json = pm.response.json();",
                    "if (json.token) {",
                    "  pm.collectionVariables.set('authToken', json.token);",
                    "}",
                    "if (json.user && json.user.id) {",
                    "  pm.collectionVariables.set('userId', json.user.id);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          }
        }
